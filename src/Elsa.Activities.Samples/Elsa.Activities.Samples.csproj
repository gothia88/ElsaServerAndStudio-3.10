<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Elsa.Activities.Samples</RootNamespace>

    <!-- NuGet packaging (dotnet pack) -->
    <IsPackable>true</IsPackable>
    <PackageId>Elsa.Activities.Samples</PackageId>
    <Version>1.0.0</Version>
    <Authors>Tajan</Authors>
    <Description>Sample Elsa 3.10 activity plugin. Copy as a template for per-team activity libraries.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- When used as a runtime plugin (dropped into the plugins/ folder), shared
         Elsa dependencies are resolved from the host, not copied alongside. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elsa.Workflows.Core" />
  </ItemGroup>

</Project>
